    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robostore_bringup/meshes/visual/material_box.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="box_in_joint" type="fixed">
    <origin xyz="-0.355 0.245 0.635" rpy="0 0 -${M_PI_2}"/>
    <parent link="box_table_base_link"/>
    <child link="box_in_link"/>
  </joint>

  <link name="box_out_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robostore_bringup/meshes/visual/material_box.STL" />
      </geometry>
      <material name="">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>


    </collision>
  </link>

  <joint name="box_out_joint" type="fixed">
    <origin xyz="0 0.245 0.635" rpy="0 0 -${M_PI_2}"/>
    <parent link="box_table_base_link"/>
    <child link="box_out_link"/>
  </joint> -->


</robot>
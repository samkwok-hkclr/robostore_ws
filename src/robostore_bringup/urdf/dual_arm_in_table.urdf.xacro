    <collision>
      <origin xyz="0 0 0.3175" rpy="0 0 0"/>
      <geometry>
        <box size="0.73 0.5 0.635"/>
      </geometry>
    </collision>
  </link>

  <joint name="box_table_joint" type="fixed">
    <origin xyz="0.625 0 0" rpy="0 0 0"/>
    <parent link="table_base_link"/>
    <child link="box_table_base_link"/>
  </joint>

  <link name="box_in_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robostore_bringup/meshes/visual/material_box.STL" />
